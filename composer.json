{
    "name": "apartejs/laravel",
    "description": "aparté for Laravel: an AI chat for Blade, Livewire and Filament, wired to the Laravel AI SDK.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "ai", "chat", "livewire", "filament", "ag-ui", "web-components"],
    "homepage": "https://apartejs.dev/frameworks/laravel/",
    "support": {
        "issues": "https://github.com/apartejs/laravel/issues",
        "source": "https://github.com/apartejs/laravel"
    },
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "laravel/ai": "^1.3"
    },
    "suggest": {
        "filament/filament": "To put the chat in a panel, with ApartePlugin (^4.0 or ^5.0)."
    },
    "autoload": {
        "psr-4": {
            "Aparte\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aparte\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aparte\\Laravel\\AparteServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.3",
        "pestphp/pest": "^4.0|^5.3",
        "filament/filament": "^5.0"
    }
}
